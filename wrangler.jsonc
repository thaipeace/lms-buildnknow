{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lms-buildnknow",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lms-db",
      "database_id": "62a49310-2258-455a-b31d-2a8101e2bbfa"
    }
  ]
}
